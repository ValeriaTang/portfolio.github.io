---
import { identity } from '../data/about';
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="about" aria-labelledby="about-heading">
  <h2 id="about-heading"></h2>
  <h3 data-i18n="about.heading">私について</h3>

  <dl class="profile">
    <dt data-i18n="about.name">名前</dt>
    <dd>{identity.Name}</dd>

    <dt data-i18n="about.birth">生年</dt>
    <dd>{identity.birthyear}</dd>

    <dt data-i18n="about.affiliation">所属</dt>
    <dd>{identity.Affiliation}</dd>

    <dt data-i18n="about.hobbies">趣味</dt>
    <dd id="about-hobbies">{identity.hobbies.join("、")}</dd>

    <dt data-i18n="about.interests">興味</dt>
    <dd id="about-interests">{identity.interests.join("、")}</dd>
  </dl>

  <div class="profile-icon">
    <img src={`${base}/images/monster10.png`} alt={`${identity.Name} のアイコン`} class="profile-icon-img" loading="lazy" />
  </div>

  <a href={`${base}/aboutme`} class="more-aboutme" data-i18n="about.more">詳しくはこちら</a>
</section>

<style>
  #about {
    margin-block: 3rem;
  }

  #about h2 {
    margin: 0 0 0.5rem;
    color: var(--color-primary);
  }

  #about h3 {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
  }

  /*
    Profile grid: label column is auto-sized (not fixed 3em)
    so longer translations like "出生年份" / "School" won't overflow.
  */
  .profile {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  .profile dt {
    margin: 0;
    font-weight: bold;
    color: var(--color-primary);
    /* Allow wrap for very long labels */
    word-break: break-word;
  }

  .profile dd {
    margin: 0;
    color: var(--color-text);
    /* Prevent overflow on narrow viewports */
    overflow-wrap: break-word;
  }

  .more-aboutme {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.5rem 1.25rem;
    color: var(--color-white);
    text-decoration: none;
    background-color: var(--btn-bg);
    border-radius: 0.375rem;
    transition: background-color 0.2s ease;
    /* Don't let translated text wrap awkwardly */
    white-space: nowrap;
  }

  .more-aboutme:hover {
    background-color: var(--accent);
  }

  .more-aboutme:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* プロフィールアイコン */
  .profile-icon {
    margin: 1rem 0 0;
    text-align: center;
  }

  .profile-icon-img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--card-border);
    transition: border-color 0.2s ease, transform 0.1s ease;
  }

  .profile-icon-img:hover {
    border-color: var(--color-accent);
    transform: scale(1.03);
  }
</style>
