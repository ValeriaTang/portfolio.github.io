---
const pageTitle = "私について";
const identity = {
  Name: "Valeria",
  Affiliation: ["大阪公立大学工業高等専門学校", "総合工学システム科", "知能情報コース", "2年"],
  hobbies: ["ドラマ鑑賞", "スポーツ観戦"],
  birthyear: 2009,
  interests: ["自然言語処理", "IoT", "VFX"],
};
---

<section id="about" aria-labelledby="about-heading">
  <h2 id="about-heading">ポートフォリオ</h2>
  <h3>{pageTitle}</h3>

  <dl class="profile">
    <dt>名前</dt><dd>{identity.Name}</dd>
    <dt>生年</dt><dd>{identity.birthyear}</dd>
    <dt>所属</dt><dd>OMUCT {identity.Affiliation[2]} {identity.Affiliation[3]}</dd>
    <dt>趣味</dt><dd>{identity.hobbies.join(", ")}</dd>
    <dt>興味</dt><dd>{identity.interests.join(", ")}</dd>
  </dl>

  <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/aboutme`} class="more-aboutme">詳しくはこちら</a>
</section>

<style>
  /* 自己紹介セクション */
  #about {
    margin-block: 3rem;
  }

  #about h2 {
    margin: 0 0 0.5rem;
    color: var(--color-primary);
  }

  #about h3 {
    margin: 0 0 1.25rem;
    color: var(--color-text);
  }

  /* プロフィール（定義リストを2カラムグリッドで表示） */
  .profile {
    display: grid;
    grid-template-columns: 3em 1fr;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  .profile dt {
    margin: 0;
    font-weight: bold;
    color: var(--color-primary);
  }

  .profile dd {
    margin: 0;
    color: var(--color-text);
  }

  /* 詳細ページリンク */
  .more-aboutme {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.5rem 1.25rem;
    color: var(--color-white);
    text-decoration: none;
    background-color: var(--color-primary);
    border-radius: 0.375rem;
    transition: background-color 0.2s ease;
  }

  .more-aboutme:hover {
    background-color: var(--color-accent);
  }

  .more-aboutme:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
