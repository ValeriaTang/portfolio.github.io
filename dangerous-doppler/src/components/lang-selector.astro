---
import { LOCALES } from '../i18n/translations';
---

<div class="lang-selector" role="group" aria-label="言語選択 / Language">
  {LOCALES.map((locale) => (
    <button
      class="lang-btn"
      data-locale-btn={locale.code}
      aria-pressed="false"
      type="button"
    >
      {locale.label}
    </button>
  ))}
</div>

<script>
  import { LOCALES } from '../i18n/translations';
  import { getSavedLocale, setLocale, applyTranslations } from '../i18n/lang-switcher';
  import type { Locale } from '../i18n/translations';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-locale-btn]');

  function updateButtons(locale: Locale) {
    buttons.forEach((btn) => {
      const pressed = btn.dataset.localeBtn === locale;
      btn.setAttribute('aria-pressed', String(pressed));
      btn.classList.toggle('is-active', pressed);
    });
  }

  function handleChange(locale: Locale) {
    setLocale(locale);
    applyTranslations(locale);
    updateButtons(locale);
    // Dispatch for work/skill components that listen
    document.dispatchEvent(new CustomEvent('i18n:update', { detail: { locale } }));
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const locale = btn.dataset.localeBtn as Locale;
      if (locale && LOCALES.some((l) => l.code === locale)) {
        handleChange(locale);
      }
    });
  });

  // Init
  const initial = getSavedLocale();
  updateButtons(initial);
  applyTranslations(initial);
</script>

<style>
  .lang-selector {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .lang-btn {
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: var(--header-text);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
    /* Prevent layout shift when font-weight changes on active */
    min-width: 3.5em;
    text-align: center;
  }

  .lang-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .lang-btn.is-active,
  .lang-btn[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }

  .lang-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
