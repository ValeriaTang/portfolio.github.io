---

<header class="site-header">
  <div class="logo">ポートフォリオ</div>

  <nav class="pc-menu">
    <a href="#home">ホーム</a>
    <a href="#about">私について</a>
    <a href="#skills">スキル</a>
    <a href="#works">作品</a>
  </nav>

  <button class="mobile-menu-btn" id="menu-toggle" aria-label="メニューを開く" aria-expanded="false">
    <span class="line"></span>
    <span class="line"></span>
    <span class="line"></span>
  </button>

  <nav class="mobile-nav" id="mobile-menu">
    <a href="#home" class="mobile-link">ホーム</a>
    <a href="#about" class="mobile-link">私について</a>
    <a href="#skills" class="mobile-link">スキル</a>
    <a href="#works" class="mobile-link">作品</a>
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // スクロールしたらヘッダーを黒くする
  const onScroll = () => {
    header?.classList.toggle('scrolled', window.scrollY > 10);
  };
  window.addEventListener('scroll', onScroll);
  onScroll(); // 読み込み時にも一度チェック

  if (toggle && menu) {
    // ボタンでメニューを開閉
    toggle.addEventListener('click', () => {
      const isOpen = toggle.classList.toggle('is-active');
      menu.classList.toggle('is-active', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    // リンクを押したらメニューを閉じる
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.classList.remove('is-active');
        menu.classList.remove('is-active');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>