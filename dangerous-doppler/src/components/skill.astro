---
import { skills } from '../data/skill';
import { icons } from '../data/icon';

const iconMap = Object.fromEntries(
  icons.map((icon) => [icon.name, { dark: icon.darkimage, light: icon.lightimage }]),
);

const normalizedSkills = skills.map((s) => {
  const icon = iconMap[s.name];
  const lightImage = icon ? icon.light : s.image;
  const darkImage = icon ? icon.dark : s.image;
  return {
    ...s,
    hasImage: Boolean(lightImage),
    image: lightImage,
    darkImage,
  };
}).slice(0, 6);
---

<section id="skills" aria-labelledby="skills-heading">
  <h2 id="skills-heading">スキル</h2>
  <ul class="skills-grid">
    {normalizedSkills.map((s) => (
      <li class="skill-card" data-name={s.name}>
        {s.hasImage && (
          <div class="skill-thumb">
            <img src={s.image} alt="" loading="lazy" data-light-src={s.image} data-dark-src={s.darkImage} />
          </div>
        )}
        <div class="skill-body">
          <header class="skill-header">
            <h3>{s.name}</h3>
            <span class="level-badge">{s.level}</span>
          </header>
          <p class="skill-desc">{s.description}</p>
          <button
            type="button"
            class="btn btn-secondary open-modal-btn"
            data-name={s.name}
            data-level={s.level}
            data-skill={s.skill}
            data-desc={s.description}
            data-image={s.image}
            aria-label={`${s.name} の詳細を見る`}
          >
            詳しく見る
          </button>
        </div>
      </li>
    ))}
  </ul>

  <dialog id="skill-modal" class="modal-card" aria-modal="true" aria-labelledby="skill-modal-title">
    <div class="modal-content">
      <button id="skill-modal-close-btn" class="close-btn" aria-label="閉じる">×</button>

      <div class="modal-image" id="skill-modal-image"></div>

      <header class="modal-header">
        <h3 id="skill-modal-title">スキル名</h3>
        <span id="skill-modal-level" class="level-badge">レベル</span>
      </header>

      <p id="skill-modal-skill" class="modal-detail"></p>
      <p id="skill-modal-desc" class="modal-text"></p>
    </div>
  </dialog>
</section>

<script>
  const root = document.getElementById('skills');
  const modal = document.getElementById('skill-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('skill-modal-close-btn');
  const openBtns = root ? root.querySelectorAll('.open-modal-btn') : [];
  const imageWrap = document.getElementById('skill-modal-image');

  const modalTitle = document.getElementById('skill-modal-title');
  const modalLevel = document.getElementById('skill-modal-level');
  const modalSkill = document.getElementById('skill-modal-skill');
  const modalDesc = document.getElementById('skill-modal-desc');

  function renderImage(src: string): void {
    if (!imageWrap) return;
    if (!src) {
      imageWrap.innerHTML = '';
      imageWrap.style.display = 'none';
      return;
    }
    imageWrap.style.display = 'block';
    imageWrap.innerHTML = `<img src="${src}" alt="スキルのスクリーンショット" loading="lazy" />`;
  }

  openBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn as HTMLElement;
      if (modalTitle) modalTitle.textContent = target.dataset.name || '';
      if (modalLevel) modalLevel.textContent = target.dataset.level || '';
      if (modalSkill) modalSkill.textContent = target.dataset.skill || '';
      if (modalDesc) modalDesc.textContent = target.dataset.desc || '';
      renderImage(target.dataset.image || '');

      modal?.showModal();
// テーマによる画像切り替えを適用
  function applyThemeImages() {
    const isDark = !document.documentElement.hasAttribute('data-theme') || document.documentElement.getAttribute('data-theme') === 'dark';
    document.querySelectorAll('img[data-light-src][data-dark-src]').forEach((img) => {
      const imgEl = img as HTMLImageElement;
      const src = isDark ? imgEl.dataset.darkSrc : imgEl.dataset.lightSrc;
      if (src && src !== imgEl.src) {
        imgEl.src = src;
      }
    });
  }
  applyThemeImages();

  // テーマ属性の変更を監視（テーマ切り替え時に画像を更新）
  const observer = new MutationObserver(applyThemeImages);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.open) {
      modal.close();
    }
  });
 });
  })
</script>

<style>
  /* スキルセクション */
  #skills {
    margin-block: 3rem;
  }

  #skills h2 {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
  }

  /* スキルグリッド */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* スキルカード */
  .skill-card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    border-color: var(--accent);
  }

  .skill-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  .skill-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .skill-card:hover .skill-thumb img {
    transform: scale(1.03);
  }

  .skill-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    flex: 1;
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .skill-header h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--card-title);
    line-height: 1.3;
  }

  .level-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(255, 151, 118, 0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .skill-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--card-text);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.375rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
    margin-top: auto;
  }

  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn-secondary {
    color: #fff;
    background-color: #374151;
  }

  .btn-secondary:hover {
    background-color: #4b5563;
  }

  /* ===== Modal ===== */
  .modal-card {
    border: none;
    border-radius: 1rem;
    background: #111;
    color: #eee;
    max-width: 48rem;
    width: calc(100% - 2rem);
    max-height: 90vh;
    overflow: hidden;
    padding: 0;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .modal-card::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    max-height: 90vh;
    overflow-y: auto;
  }

  .close-btn {
    align-self: flex-end;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }

  .close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .close-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .modal-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
    border-radius: 0.75rem;
    margin-bottom: 0.5rem;
    display: none;
  }

  .modal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.5rem;
    color: #fff;
  }

  .modal-detail {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
    font-style: italic;
  }

  .modal-text {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card,
    .skill-thumb img,
    .btn,
    .close-btn {
      transition: none;
    }

    .skill-card:hover {
      transform: none;
    }

    .skill-card:hover .skill-thumb img {
      transform: none;
    }
  }
</style>
