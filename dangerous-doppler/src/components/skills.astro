---
const pageTitle = "スキル";
const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
import { skills } from "../data/skill.ts";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} >
    <title>{pageTitle}</title>
    <style define:vars={{skillColor, fontWeight, textCase}}>
      h1 {
        color: purple;
        font-size: 4rem;
      }
      .skill {
        color: var(--skillColor);
        font-weight: var(--fontWeight);
        text-transform: var(--textCase);
      }
</style>
  </head>
  <body>
    <h2>{pageTitle}</h2>
    <article class="work-card">
      {skills.map((skill) => (
        <img
          src={skill.image}
          alt={`${skill.name}のスクリーンショット`}
          loading="lazy"
          width="640"
          height="360"
        />
        <div class="body">
          <h3>{skill.name}</h3>
          <p>{skill.description}</p>
        </div>
      ))}
    </article>
  </body>
</html>

<style>
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    background-color: #1a1a1a;
    border: 1px solid #333;
    border-radius: 12px;
  }
  .icon {
    font-size: 2rem;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    color: #fff;
  }
  p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #bbb;
  }
  .level {
    display: flex;
    gap: 6px;
    margin-top: auto;
  }
  .dot {
    width: 12px;
    height: 12px;
    background-color: #333;
    border-radius: 50%;
  }
  .dot.on {
    background-color: #2563eb;
  }
</style>