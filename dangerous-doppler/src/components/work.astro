---
import { works } from '../data/work';
import { icons } from '../data/icon';
import { workLocales } from '../i18n/multilingual-data';

const iconMap = Object.fromEntries(
  icons.map((icon) => [icon.name, { dark: icon.darkimage, light: icon.lightimage }]),
);

function getIconUrl(tag: string, isDark: boolean): string | undefined {
  const icon = iconMap[tag];
  return icon ? (isDark ? icon.dark : icon.light) : undefined;
}

// Embed all locale data into each card so JS can swap without re-fetching
const normalizedWorks = works.map((work) => {
  const tags = work.tags ?? [];
  return {
    ...work,
    tags,
    tagDetails: tags.map((name) => ({
      name,
      icon: getIconUrl(name, false),
      darkIcon: getIconUrl(name, true),
    })),
    images: [work.image1, work.image2, work.image3, work.image4, work.image5].filter(
      (src): src is string => Boolean(src),
    ),
    // All locale data embedded as JSON for client-side use
    locales: workLocales[work.id] ?? null,
  };
}).slice(0, 3);
---

<section id="works" aria-labelledby="works-heading">
  <h2 id="works-heading" data-i18n="works.heading">作品</h2>
  <div class="works-grid">
    {normalizedWorks.map((work) => {
      const ja = work.locales?.ja;
      return (
        <article
          class="work-card open-modal-btn"
          data-id={work.id}
          data-ai={work.aiRatio}
          data-start={work.start}
          data-finish={work.finish}
          data-tags={JSON.stringify(work.tagDetails)}
          data-images={JSON.stringify(work.images)}
          data-url={work.href}
          data-locales={JSON.stringify(work.locales)}
          aria-label={`${ja?.title ?? work.id} の詳細を見る`}
          role="button"
          tabindex="0"
        >
          {work.images[0] && (
            <div class="work-thumb">
              <img src={work.images[0]} alt="" loading="lazy" />
            </div>
          )}
          <div class="work-body">
            <header class="work-header">
              <h3 class="work-title">{ja?.title ?? work.id}</h3>
              <span class="ai-ratio">
                <span data-i18n="works.aiRatio">AI使用率</span>: {work.aiRatio}
              </span>
            </header>
            <p class="work-desc">{ja?.description ?? ''}</p>
            <div class="work-meta">
              <time datetime={work.start}>{work.start.replace('-', '.')}</time>
              <span aria-hidden="true">-</span>
              <time datetime={work.finish}>{work.finish.replace('-', '.')}</time>
            </div>
            {work.tagDetails.length > 0 && (
              <ul class="work-tags" aria-label="使用技術" data-i18n-aria="works.tags">
                {work.tagDetails.map((tag) => (
                  <li class="tag-item">
                    {tag.icon ? (
                      <img src={tag.icon} alt={tag.name} class="tag-icon" />
                    ) : (
                      <span class="tag-text">{tag.name}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <div class="work-more-link">
    <a class="btn btn-primary" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/works`} data-i18n="works.more">
      詳しくはこちら
    </a>
  </div>

  <!-- Modal -->
  <dialog id="work-modal" class="modal-card" aria-modal="true" aria-labelledby="work-modal-title">
    <div class="modal-content">
      <button id="work-modal-close-btn" class="close-btn" aria-label="閉じる" data-i18n-aria="works.modal.close">×</button>

      <div class="modal-gallery" id="work-modal-gallery"></div>

      <header class="modal-header">
        <h3 id="work-modal-title">タイトル</h3>
        <span id="work-modal-ai" class="badge">AI使用率</span>
      </header>

      <div class="modal-meta">
        <div>
          <span class="meta-label" data-i18n="works.modal.period">期間</span>:
          <span id="work-modal-period"></span>
        </div>
      </div>

      <p id="work-modal-ai-desc" class="modal-ai-desc"></p>
      <p id="work-modal-detail" class="modal-text"></p>

      <div id="work-modal-tags" class="modal-tags" aria-label="使用技術" data-i18n-aria="works.tags"></div>

      <a id="work-modal-link" href="#" target="_blank" rel="noopener noreferrer" class="github-link" data-i18n="works.modal.github">
        GitHubでコードを見る
      </a>
    </div>
  </dialog>
</section>

<script>
  import { getSavedLocale } from '../i18n/lang-switcher';
  import { translations } from '../i18n/translations';
  import type { Locale } from '../i18n/translations';

  const root     = document.getElementById('works');
  const modal    = document.getElementById('work-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('work-modal-close-btn');
  const gallery  = document.getElementById('work-modal-gallery');
  const modalTitle   = document.getElementById('work-modal-title');
  const modalAi      = document.getElementById('work-modal-ai');
  const modalAiDesc  = document.getElementById('work-modal-ai-desc');
  const modalDetail  = document.getElementById('work-modal-detail');
  const modalPeriod  = document.getElementById('work-modal-period');
  const modalTags    = document.getElementById('work-modal-tags');
  const modalLink    = document.getElementById('work-modal-link') as HTMLAnchorElement | null;

  // Track last opened card for locale refresh
  let lastCard: HTMLElement | null = null;

  function getLocale(): Locale { return getSavedLocale(); }

  function getDict(locale: Locale) { return translations[locale]; }

  function formatPeriod(start: string, finish: string): string {
    const fmt = (s: string) => s.replace('-', '.');
    return `${fmt(start)} 〜 ${fmt(finish)}`;
  }

  function renderGallery(images: string[]): void {
    if (!gallery) return;
    if (images.length === 0) { gallery.innerHTML = ''; gallery.style.display = 'none'; return; }
    gallery.style.display = 'flex';
    gallery.innerHTML = images
      .map((src, i) => `<img src="${src}" alt="Work image ${i + 1}" loading="lazy" />`)
      .join('');
  }

  function renderTags(raw: string): void {
    if (!modalTags) return;
    let tags: { name: string; icon: string | null }[] = [];
    try { tags = raw ? JSON.parse(raw) : []; } catch { tags = []; }
    modalTags.innerHTML = tags
      .map((tag) =>
        tag.icon
          ? `<span class="tag-item"><img src="${tag.icon}" alt="${tag.name}" class="tag-icon" /></span>`
          : `<span class="tag-item"><span class="tag-text">${tag.name}</span></span>`,
      )
      .join('');
  }

  function populateModal(card: HTMLElement): void {
    const locale = getLocale();
    const dict   = getDict(locale);

    // Get localised text from embedded JSON
    let locales: Record<string, { title: string; description: string; AI: string }> | null = null;
    try { locales = card.dataset.locales ? JSON.parse(card.dataset.locales) : null; } catch {}
    const localised = locales?.[locale] ?? locales?.['ja'] ?? null;

    if (modalTitle) modalTitle.textContent = localised?.title ?? '';
    if (modalAi)    modalAi.textContent = `${dict['works.aiRatio']}: ${card.dataset.ai ?? ''}`;
    if (modalAiDesc) modalAiDesc.textContent = localised?.AI ?? '';
    if (modalDetail) modalDetail.textContent = localised?.description ?? '';
    if (modalPeriod) modalPeriod.textContent = formatPeriod(card.dataset.start ?? '', card.dataset.finish ?? '');
    if (modalLink) {
      modalLink.href = card.dataset.url ?? '#';
      modalLink.textContent = dict['works.modal.github'];
    }
    renderGallery(card.dataset.images ? JSON.parse(card.dataset.images) : []);
    renderTags(card.dataset.tags ?? '');
  }

  // ── Open modal ──
  const openBtns = root ? root.querySelectorAll<HTMLElement>('.open-modal-btn') : [];
  openBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      lastCard = btn;
      populateModal(btn);
      modal?.showModal();
    });
    // Keyboard accessibility
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        btn.click();
      }
    });
  });

  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal?.open) modal.close(); });

  // ── Update card text on locale change ──
  function updateCards(): void {
    const locale = getLocale();
    const dict   = getDict(locale);
    openBtns.forEach((btn) => {
      let locales: Record<string, { title: string; description: string; AI: string }> | null = null;
      try { locales = btn.dataset.locales ? JSON.parse(btn.dataset.locales) : null; } catch {}
      const localised = locales?.[locale] ?? locales?.['ja'] ?? null;

      const titleEl = btn.querySelector<HTMLElement>('.work-title');
      const descEl  = btn.querySelector<HTMLElement>('.work-desc');
      const aiEl    = btn.querySelector<HTMLElement>('.ai-ratio');
      const tagsAria = btn.querySelector<HTMLElement>('.work-tags');

      if (titleEl && localised) titleEl.textContent = localised.title;
      if (descEl  && localised) descEl.textContent  = localised.description;
      if (aiEl) {
        const aiRatio = btn.dataset.ai ?? '';
        aiEl.innerHTML = `<span data-i18n="works.aiRatio">${dict['works.aiRatio']}</span>: ${aiRatio}`;
      }
      if (tagsAria) tagsAria.setAttribute('aria-label', dict['works.tags']);
      btn.setAttribute('aria-label', `${localised?.title ?? ''} の詳細を見る`);
    });
    // If modal is open, refresh its content too
    if (modal?.open && lastCard) populateModal(lastCard);
  }

  document.addEventListener('i18n:update', updateCards);

  // ── More-link click guard ──
  document.querySelectorAll('.work-more-link a').forEach((link) => {
    link.addEventListener('click', (e) => e.stopPropagation());
  });

  // ── Theme-aware images ──
  function applyThemeImages(): void {
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    document.querySelectorAll<HTMLImageElement>('img[data-light-src][data-dark-src]').forEach((img) => {
      const src = isDark ? img.dataset.darkSrc : img.dataset.lightSrc;
      if (src && src !== img.src) img.src = src;
    });
  }
  applyThemeImages();
  new MutationObserver(applyThemeImages).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme'],
  });
</script>

<style>
  /* 作品セクション */
  #works {
    margin-block: 2rem;
  }

  #works h2 {
    margin: 0 0 0.75rem;
    color: var(--color-primary);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (max-width: 600px) {
    .works-grid { grid-template-columns: 1fr; }
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .work-card:hover,
  .work-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    border-color: var(--accent);
    outline: none;
  }

  .work-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--card-bg);
  }

  .work-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .work-card:hover .work-thumb img { transform: scale(1.03); }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.5rem;
    flex: 1;
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap; /* Long titles wrap without pushing badge off */
  }

  .work-header h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--card-title);
    line-height: 1.3;
    /* Ensure long CJK titles break properly */
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0; /* Allow flex shrink */
  }

  .ai-ratio {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    background: var(--accent-bg);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .work-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--card-text);
    /* Clamp to 3 lines regardless of language verbosity */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    max-height: calc(2 * (1.5rem + 0.375rem));
    overflow: hidden;
  }

  .work-more-link {
    margin-top: 1rem;
    text-align: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.375rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
    white-space: nowrap;
  }

  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .btn:active { transform: scale(0.98); }

  .btn-primary { color: var(--color-white); background-color: var(--btn-bg); }
  .btn-primary:hover { background-color: var(--accent); }

  /* ===== Modal ===== */
  .modal-card {
    border: none;
    border-radius: 1rem;
    background: var(--modal-bg);
    color: var(--modal-text);
    max-width: 56rem;
    width: calc(100% - 2rem);
    max-height: 90vh;
    overflow: hidden;
    padding: 0;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .modal-card::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    max-height: 90vh;
    overflow-y: auto;
  }

  .close-btn {
    align-self: flex-end;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--modal-heading);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }

  .close-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .close-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .modal-gallery {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .modal-gallery img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .modal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--modal-heading);
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .modal-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    flex-wrap: wrap;
  }

  .meta-label { font-weight: 600; }

  .modal-ai-desc {
    margin: 0.5rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    font-style: italic;
    overflow-wrap: break-word;
  }

  .modal-text {
    margin: 0.5rem 0 1rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
    overflow-wrap: break-word;
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .github-link {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.625rem 1.25rem;
    color: var(--color-white);
    text-decoration: none;
    background-color: var(--btn-bg);
    border-radius: 0.375rem;
    font-weight: 500;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .github-link:hover { background-color: var(--accent); }
  .github-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Tags */
  .tag-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0 0.5rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--card-border);
    transition: background 0.2s, border-color 0.2s;
  }

  .tag-item:hover { background: rgba(255, 255, 255, 0.1); border-color: var(--accent); }

  .tag-icon { width: 1.1rem; height: 1.1rem; object-fit: contain; }
  .tag-text { font-size: 0.7rem; font-weight: 500; color: var(--card-text); white-space: nowrap; }

  .modal-tags .tag-item {
    aspect-ratio: unset;
    min-width: 1.75rem;
    min-height: 1.75rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card, .work-thumb img, .btn, .close-btn, .github-link { transition: none; }
    .work-card:hover { transform: none; }
    .work-card:hover .work-thumb img { transform: none; }
  }

  /* Dark mode */
  [data-theme="dark"] .work-thumb { background: #ffffff; }
  [data-theme="dark"] .work-thumb img { filter: none; }
  [data-theme="dark"] .tag-icon { filter: invert(1); }
</style>
