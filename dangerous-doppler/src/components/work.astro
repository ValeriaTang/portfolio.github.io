---
import { works } from '../data/work';
import { icons } from '../data/icon';
import { workLocales } from '../i18n/multilingual-data';

const iconMap = Object.fromEntries(
  icons.map((icon) => [icon.name, { dark: icon.darkimage, light: icon.lightimage }]),
);

function getIconUrl(tag: string, isDark: boolean): string | undefined {
  const icon = iconMap[tag];
  return icon ? (isDark ? icon.dark : icon.light) : undefined;
}

const normalizedWorks = works.map((work) => {
  const tags = work.tags ?? [];
  return {
    ...work,
    tags,
    tagDetails: tags.map((name) => ({
      name,
      icon: getIconUrl(name, false),
      darkIcon: getIconUrl(name, true),
    })),
    images: [work.image1, work.image2, work.image3, work.image4, work.image5].filter(
      (src): src is string => Boolean(src),
    ),
    locales: workLocales[work.id] ?? null,
  };
}).slice(0, 4); // トップページでバランスよく表示
---

<section id="works" aria-labelledby="works-heading">
  <h2 id="works-heading" data-i18n="works.heading">作品</h2>
  <div class="works-grid">
    {normalizedWorks.map((work) => {
      const ja = work.locales?.ja;
      return (
        <article
          class="work-card"
          data-id={work.id}
          data-ai={work.aiRatio}
          data-start={work.start}
          data-finish={work.finish}
          data-tags={JSON.stringify(work.tagDetails)}
          data-images={JSON.stringify(work.images)}
          data-url={work.href}
          data-locales={JSON.stringify(work.locales)}
        >
          <div class="work-thumb">
            {work.images[0] ? (
              <img src={work.images[0]} alt="" loading="lazy" />
            ) : (
              <div class="work-thumb-placeholder">
                <span class="placeholder-icon">💻</span>
                <span class="placeholder-text">{ja?.title ?? work.id}</span>
              </div>
            )}
          </div>

          <div class="work-body">
            <header class="work-header">
              <h3 class="work-title">{ja?.title ?? work.id}</h3>
              <span class="ai-ratio">
                <span data-i18n="works.aiRatio">AI使用率</span>: {work.aiRatio}
              </span>
            </header>

            <div class="work-section">
              <h4 class="work-subheading" data-i18n="works.card.period">開発期間</h4>
              <div class="work-meta">
                <time datetime={work.start}>{work.start.replace('-', '.')}</time>
                <span aria-hidden="true">-</span>
                <time datetime={work.finish}>{work.finish.replace('-', '.')}</time>
              </div>
            </div>

            {work.locales?.ja?.AI && (
              <div class="work-section">
                <h4 class="work-subheading" data-i18n="works.card.aiLocation">AIの使用場所</h4>
                <p class="work-ai-note work-ai-note-text">{work.locales.ja.AI}</p>
              </div>
            )}

            <div class="work-section">
              <h4 class="work-subheading" data-i18n="works.card.overview">概要</h4>
              <p class="work-desc">{ja?.description ?? ''}</p>
            </div>

            {work.tagDetails.length > 0 && (
              <ul class="work-tags" aria-label="使用技術" data-i18n-aria="works.tags">
                {work.tagDetails.map((tag) => (
                  <li class="tag-item">
                    {tag.icon ? (
                      <img
                        src={tag.icon}
                        alt={tag.name}
                        class="tag-icon"
                        data-light-src={tag.icon}
                        data-dark-src={tag.darkIcon}
                      />
                    ) : (
                      <span class="tag-text">{tag.name}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}

            <div class="work-actions">
              <a href={work.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                GitHub / Demo
              </a>
              <button
                type="button"
                class="btn btn-secondary open-modal-btn"
                data-id={work.id}
                data-ai={work.aiRatio}
                data-start={work.start}
                data-finish={work.finish}
                data-tags={JSON.stringify(work.tagDetails)}
                data-images={JSON.stringify(work.images)}
                data-url={work.href}
                data-locales={JSON.stringify(work.locales)}
                aria-label={`${ja?.title ?? work.id} の詳細を見る`}
              >
                <span data-i18n="works.detail">詳しく見る</span>
              </button>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <div class="work-more-link">
    <a class="btn btn-primary" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/works`} data-i18n="works.more">
      詳しくはこちら
    </a>
  </div>

  <!-- Modal -->
  <dialog id="work-modal" class="modal-card" aria-modal="true" aria-labelledby="work-modal-title">
    <div class="modal-content">
      <button id="work-modal-close-btn" class="close-btn" aria-label="閉じる" data-i18n-aria="works.modal.close">×</button>

      <div class="modal-gallery" id="work-modal-gallery"></div>

      <header class="modal-header">
        <h3 id="work-modal-title">タイトル</h3>
        <span id="work-modal-ai" class="badge">AI使用率</span>
      </header>

      <div class="modal-meta">
        <h4 class="modal-subheading" data-i18n="works.modal.period">開発期間</h4>
        <div>
          <span id="work-modal-period"></span>
        </div>
      </div>

      <h4 class="modal-subheading" data-i18n="works.modal.ai">AI使用場所</h4>
      <p id="work-modal-ai-desc" class="modal-ai-desc"></p>

      <h4 class="modal-subheading" data-i18n="works.modal.detail">詳細</h4>
      <p id="work-modal-detail" class="modal-text"></p>

      <h4 class="modal-subheading" data-i18n="works.tags">使用技術</h4>
      <div id="work-modal-tags" class="modal-tags" aria-label="使用技術" data-i18n-aria="works.tags"></div>

      <a id="work-modal-link" href="#" target="_blank" rel="noopener noreferrer" class="github-link" data-i18n="works.modal.github">
        GitHubでコードを見る
      </a>
    </div>
  </dialog>
</section>

<script type="module">
  import { initWorkModal } from '../scripts/work-modal';
  initWorkModal();
</script>
<style>
  /* 作品セクション */
  #works {
    margin-block: 2rem;
  }

  #works h2 {
    margin: 0 0 1rem;
    color: var(--color-primary);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
    border-color: var(--accent);
  }

  /* サムネイル画像領域 */
  .work-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    position: relative;
    border-bottom: 1px solid var(--card-border);
  }

  .work-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .work-card:hover .work-thumb img {
    transform: scale(1.03);
  }

  /* 画像がない場合のプレースホルダー */
  .work-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15) 0%, rgba(192, 132, 252, 0.15) 100%);
    padding: 1rem;
    text-align: center;
  }

  .placeholder-icon {
    font-size: 2rem;
  }

  .placeholder-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--card-title);
    opacity: 0.8;
  }

  /* カードコンテンツ本文 */
  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
    flex: 1;
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .work-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--card-title);
    line-height: 1.35;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
    flex: 1;
  }

  .ai-ratio {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    background: var(--accent-bg);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  /* 各情報セクション */
  .work-section {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .work-subheading {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 500;
  }

  .work-ai-note {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
    font-style: italic;
    overflow-wrap: break-word;
  }

  .work-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--card-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
  }

  .work-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    flex-wrap: wrap;
  }

  .work-more-link {
    margin-top: 1.5rem;
    text-align: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.375rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
    white-space: nowrap;
  }

  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .btn:active { transform: scale(0.98); }

  .btn-primary { color: var(--color-white); background-color: var(--btn-bg); }
  .btn-primary:hover { background-color: var(--accent); }

  .btn-secondary { color: var(--color-white); background-color: var(--btn-secondary); }
  .btn-secondary:hover { background-color: var(--accent); }

  /* ===== Modal ===== */
  .modal-card {
    border: none;
    border-radius: 1rem;
    background: var(--modal-bg);
    color: var(--modal-text);
    max-width: 56rem;
    width: calc(100% - 2rem);
    max-height: 90vh;
    overflow: hidden;
    padding: 0;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .modal-card::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    max-height: 90vh;
    overflow-y: auto;
  }

  .close-btn {
    align-self: flex-end;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--modal-heading);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }

  .close-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .close-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .modal-gallery {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .modal-gallery img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .modal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--modal-heading);
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .modal-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .modal-subheading {
    margin: 0.6rem 0 0.2rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  .modal-ai-desc {
    margin: 0.25rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    font-style: italic;
    overflow-wrap: break-word;
  }

  .modal-text {
    margin: 0.25rem 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
    overflow-wrap: break-word;
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .github-link {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.625rem 1.25rem;
    color: var(--color-white);
    text-decoration: none;
    background-color: var(--btn-bg);
    border-radius: 0.375rem;
    font-weight: 500;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .github-link:hover { background-color: var(--accent); }
  .github-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Tags */
  .tag-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0 0.5rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--card-border);
    transition: background 0.2s, border-color 0.2s;
  }

  .tag-item:hover { background: rgba(255, 255, 255, 0.1); border-color: var(--accent); }

  .tag-icon { width: 1.1rem; height: 1.1rem; object-fit: contain; }
  .tag-text { font-size: 0.7rem; font-weight: 500; color: var(--card-text); white-space: nowrap; }

  .modal-tags .tag-item {
    aspect-ratio: unset;
    min-width: 1.75rem;
    min-height: 1.75rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card, .work-thumb img, .btn, .close-btn, .github-link { transition: none; }
    .work-card:hover { transform: none; }
    .work-card:hover .work-thumb img { transform: none; }
  }

  /* Dark mode */
  [data-theme="dark"] .work-thumb { background: #111111; }
  [data-theme="dark"] .work-thumb img { filter: none; }
  [data-theme="dark"] .tag-icon { filter: invert(1); }

  /* Light mode */
  [data-theme="light"] .work-thumb { background: #f1f5f9; }
</style>
