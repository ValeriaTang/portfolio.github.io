---
import { works } from '../data/work';

const normalizedWorks = works.map((work) => ({
  ...work,
  tags: work.tags ?? [],
  images: [work.image1, work.image2, work.image3, work.image4, work.image5].filter(
    (src): src is string => Boolean(src),
  ),
}));
---

<section id="works" aria-labelledby="works-heading">
  <h2 id="works-heading">作品</h2>
  <div class="works-grid">
    {normalizedWorks.map((work) => (
      <article class="work-card" data-id={work.id}>
        {work.image1 && (
          <div class="work-thumb">
            <img src={work.image1} alt="" loading="lazy" />
          </div>
        )}
        <div class="work-body">
          <header class="work-header">
            <h3>{work.title}</h3>
            <span class="ai-ratio">AI使用率: {work.aiRatio}</span>
          </header>
          <p class="work-desc">{work.description}</p>
          <div class="work-meta">
            <time datetime={work.start}>{work.start.replace('-', '.')}</time>
            <span aria-hidden="true">–</span>
            <time datetime={work.finish}>{work.finish.replace('-', '.')}</time>
          </div>
          {work.tags.length > 0 && (
            <ul class="work-tags" aria-label="使用技術">
              {work.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
          {work.AI && (
            <p class="work-ai-note">{work.AI}</p>
          )}
          <div class="work-actions">
            <a href={work.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              GitHub / Demo
            </a>
            <button
              type="button"
              class="btn btn-secondary open-modal-btn"
              data-id={work.id}
              data-title={work.title}
              data-ai={work.aiRatio}
              data-ai-desc={work.AI}
              data-detail={work.description}
              data-start={work.start}
              data-finish={work.finish}
              data-tags={work.tags.join(', ')}
              data-images={JSON.stringify(work.images)}
              data-url={work.href}
              aria-label={`${work.title} の詳細を見る`}
            >
              詳しく見る
            </button>
          </div>
        </div>
      </article>
    ))}
  </div>

  <dialog id="work-modal" class="modal-card" aria-modal="true" aria-labelledby="work-modal-title">
    <div class="modal-content">
      <button id="work-modal-close-btn" class="close-btn" aria-label="閉じる">×</button>

      <div class="modal-gallery" id="work-modal-gallery"></div>

      <header class="modal-header">
        <h3 id="work-modal-title">タイトル</h3>
        <span id="work-modal-ai" class="badge">AI使用率</span>
      </header>

      <div class="modal-meta">
        <div>
          <span class="meta-label">期間:</span>
          <span id="work-modal-period"></span>
        </div>
      </div>

      <p id="work-modal-ai-desc" class="modal-ai-desc"></p>
      <p id="work-modal-detail" class="modal-text"></p>

      <div id="work-modal-tags" class="modal-tags" aria-label="使用技術"></div>

      <a id="work-modal-link" href="#" target="_blank" rel="noopener noreferrer" class="github-link">
        GitHubでコードを見る
      </a>
    </div>
  </dialog>
</section>

<script>
  const root = document.getElementById('works');
  const modal = document.getElementById('work-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('work-modal-close-btn');
  const openBtns = root ? root.querySelectorAll('.open-modal-btn') : [];
  const gallery = document.getElementById('work-modal-gallery');

  const modalTitle = document.getElementById('work-modal-title');
  const modalAi = document.getElementById('work-modal-ai');
  const modalAiDesc = document.getElementById('work-modal-ai-desc');
  const modalDetail = document.getElementById('work-modal-detail');
  const modalPeriod = document.getElementById('work-modal-period');
  const modalTags = document.getElementById('work-modal-tags');
  const modalLink = document.getElementById('work-modal-link') as HTMLAnchorElement | null;

  function formatPeriod(start: string, finish: string): string {
    const fmt = (s: string) => s.replace('-', '.');
    return `${fmt(start)} 〜 ${fmt(finish)}`;
  }

  function renderGallery(images: string[]): void {
    if (!gallery) return;
    if (images.length === 0) {
      gallery.innerHTML = '';
      gallery.style.display = 'none';
      return;
    }
    gallery.style.display = 'grid';
    gallery.innerHTML = images
      .map((src, i) => `<img src="${src}" alt="作品画像${i + 1}" loading="lazy" />`)
      .join('');
  }

  function renderTags(tags: string): void {
    if (!modalTags) return;
    const arr = tags.split(',').map((s) => s.trim()).filter(Boolean);
    if (arr.length === 0) {
      modalTags.innerHTML = '';
      return;
    }
    modalTags.innerHTML = arr.map((t) => `<span class="tag">${t}</span>`).join('');
  }

  openBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn as HTMLElement;
      if (modalTitle) modalTitle.textContent = target.dataset.title || '';
      if (modalAi) modalAi.textContent = `AI使用率: ${target.dataset.ai || ''}`;
      if (modalAiDesc) modalAiDesc.textContent = target.dataset.aiDesc || '';
      if (modalDetail) modalDetail.textContent = target.dataset.detail || '';
      if (modalPeriod) modalPeriod.textContent = formatPeriod(target.dataset.start || '', target.dataset.finish || '');
      if (modalLink) modalLink.href = target.dataset.url || '#';
      renderGallery(target.dataset.images ? JSON.parse(target.dataset.images) : []);
      renderTags(target.dataset.tags || '');

      modal?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.open) {
      modal.close();
    }
  });
</script>

<style>
  /* 作品セクション */
  #works {
    --card-bg: #1a1a1a;
    --card-border: #333;
    --card-text: #bbb;
    --card-title: #fff;
    --btn-bg: #2563eb;
    --btn-bg-hover: #1d4ed8;
    --btn-secondary: #374151;
    --btn-secondary-hover: #4b5563;
    --muted: #888;
    --accent: #ff9776;

    margin-block: 3rem;
  }

  #works h2 {
    margin: 0 0 1.25rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    border-color: var(--accent);
  }

  .work-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  .work-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .work-card:hover .work-thumb img {
    transform: scale(1.03);
  }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    flex: 1;
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .work-header h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--card-title);
    line-height: 1.3;
  }

  .ai-ratio {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    background: rgba(255, 151, 118, 0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
  }

  .work-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--card-text);
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
  }

  .work-tags li {
    font-size: 0.7rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--card-border);
    color: var(--card-text);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
  }

  .work-ai-note {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
    font-style: italic;
  }

  .work-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.375rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn-primary {
    color: #fff;
    background-color: var(--btn-bg);
  }

  .btn-primary:hover {
    background-color: var(--btn-bg-hover);
  }

  .btn-secondary {
    color: #fff;
    background-color: var(--btn-secondary);
  }

  .btn-secondary:hover {
    background-color: var(--btn-secondary-hover);
  }

  /* ===== Modal ===== */
  .modal-card {
    border: none;
    border-radius: 1rem;
    background: #111;
    color: #eee;
    max-width: 56rem;
    width: calc(100% - 2rem);
    max-height: 90vh;
    overflow: hidden;
    padding: 0;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .modal-card::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    max-height: 90vh;
    overflow-y: auto;
  }

  .close-btn {
    align-self: flex-end;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }

  .close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .close-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .modal-gallery {
    display: none;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .modal-gallery img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.5rem;
    background: #222;
  }

  .modal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.5rem;
    color: #fff;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(255, 151, 118, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .modal-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .meta-label {
    font-weight: 600;
    color: #aaa;
  }

  .modal-ai-desc {
    margin: 0.5rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    font-style: italic;
  }

  .modal-text {
    margin: 0.5rem 0 1rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .modal-tags .tag {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--card-border);
    color: var(--card-text);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .github-link {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.625rem 1.25rem;
    color: #fff;
    text-decoration: none;
    background-color: var(--btn-bg);
    border-radius: 0.375rem;
    font-weight: 500;
    transition: background-color 0.2s;
  }

  .github-link:hover {
    background-color: var(--btn-bg-hover);
  }

  .github-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-thumb img,
    .btn,
    .close-btn,
    .github-link {
      transition: none;
    }

    .work-card:hover {
      transform: none;
    }

    .work-card:hover .work-thumb img {
      transform: none;
    }
  }
</style>
