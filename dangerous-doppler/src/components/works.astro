---
import { works } from '../data/work';
---

<section id="works" aria-labelledby="works-heading">
  <h2 id="works-heading">作品</h2>
  <div class="works-grid">
    {works.map((work) => (
      <div class="work-card">
        <h3>{work.title}</h3>
        <p>AI使用率: {work.aiRatio}</p>
        <p>{work.description}</p>
        <a href={work.href} class="btn">詳細を見る</a>
      </div>
    ))}
  </div>
</section>

<style>
  /* 作品セクション */
  #works {
    --card-bg: #1a1a1a;
    --card-border: #333;
    --card-text: #bbb;
    --card-title: #fff;
    --btn-bg: #2563eb;
    --btn-bg-hover: #1d4ed8;

    margin-block: 3rem;
  }

  #works h2 {
    margin: 0 0 1.25rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .work-card h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--card-title);
  }

  .work-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
  }

  .btn {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.5rem 1.25rem;
    color: #fff;
    text-decoration: none;
    background-color: var(--btn-bg);
    border-radius: 0.375rem;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background-color: var(--btn-bg-hover);
  }

  .btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .btn {
      transition: none;
    }

    .work-card:hover {
      transform: none;
    }
  }
</style>
