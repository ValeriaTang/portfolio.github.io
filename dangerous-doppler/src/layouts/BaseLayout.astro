---
import type { TranslationKey } from "../i18n/translations";
import "../styles/global.css";

interface Props {
  titleKey: TranslationKey;
  title: string;
  descriptionKey?: TranslationKey;
  description?: string;
}

const { titleKey, title, descriptionKey, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/icon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/icon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title data-i18n={titleKey}>{title}</title>
    <meta
      name="description"
      data-i18n-content={descriptionKey ?? "meta.description"}
      content={description ?? ""}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = saved || (prefersDark ? "dark" : "light");
        if (theme === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        }
        var locale = localStorage.getItem("locale") || "ja";
        document.documentElement.setAttribute("data-locale", locale);
        var langMap = { "ja": "ja", "en": "en", "zh-CN": "zh-Hans", "zh-TW": "zh-Hant" };
        document.documentElement.setAttribute("lang", langMap[locale] || locale);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>