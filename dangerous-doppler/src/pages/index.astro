---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/navigation.astro";
import About from "../components/about.astro";
import Footer from "../components/footer.astro";
import Skills from "../components/skill.astro";
import Works from "../components/work.astro";
import BackToTop from "../components/back-to-top.astro";
import LoadingSpinner from "../components/loading-spinner.astro";
---

<BaseLayout titleKey="home.title" title="Welcome to My Portfolio" descriptionKey="meta.description">
  <LoadingSpinner />
  <Navigation />

  <main>
    <section id="home">
      <h1 data-i18n="home.title">Welcome to My Portfolio</h1>
    </section>

    <About />

    <Skills />

    <Works />
  </main>

  <Footer />

  <BackToTop />
</BaseLayout>
