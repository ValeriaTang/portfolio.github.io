---
import BaseLayout from "../layouts/BaseLayout.astro";
import LoadingSpinner from '../components/loading-spinner.astro';
import { skills } from '../data/skill';
import { icons } from '../data/icon';
import { skillLocales } from '../i18n/multilingual-data';
import Header from '../components/header.astro';
import BackToTop from '../components/back-to-top.astro';
import Footer from '../components/footer.astro';

const iconMap = Object.fromEntries(
  icons.map((icon) => [icon.name, { dark: icon.darkimage, light: icon.lightimage }]),
);

const normalizedSkills = skills.map((s) => {
  const icon = iconMap[s.name];
  const lightImage = icon ? icon.light : s.image;
  const darkImage  = icon ? icon.dark  : s.image;
  return {
    ...s,
    hasImage: Boolean(lightImage),
    image: lightImage,
    darkImage,
    locales: skillLocales[s.name] ?? null,
  };
});

// Use Japanese genre keys for grouping; JS will swap labels
const genres = ['バックエンド', 'フロントエンド', 'フレームワーク', 'インフラ', 'その他'];
const genreI18nKeys: Record<string, string> = {
  'バックエンド': 'genre.backend',
  'フロントエンド': 'genre.frontend',
  'フレームワーク': 'genre.framework',
  'インフラ': 'genre.infra',
  'その他': 'genre.other',
};

const groupedSkills = genres.map((genre) => ({
  genre,
  i18nKey: genreI18nKeys[genre],
  skills: normalizedSkills.filter((s) => s.genre === genre),
})).filter((g) => g.skills.length > 0);
---

<BaseLayout titleKey="skills.title" title="スキル" descriptionKey="meta.skills">
  <LoadingSpinner />
  <Header />
  <main>
    <section id="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading" data-i18n="skills.heading">スキル</h2>
      {groupedSkills.map((group) => (
        <div class="genre-section" aria-labelledby={"genre-" + group.genre}>
          <h3 id={"genre-" + group.genre} class="genre-heading" data-i18n={group.i18nKey}>{group.genre}</h3>
          <ul class="skills-grid">
            {group.skills.map((s) => {
              const ja = s.locales?.ja;
              return (
                <li class="skill-item">
                  <button
                    type="button"
                    class="skill-card open-modal-btn"
                    data-name={s.name}
                    data-locales={JSON.stringify(s.locales)}
                    data-image={s.image}
                    aria-label={`${s.name} (${ja?.level ?? s.level}) の詳細を見る`}
                  >
                    <div class="skill-thumb">
                      {s.hasImage ? (
                        <img
                          src={s.image}
                          alt={s.name}
                          loading="lazy"
                          data-light-src={s.image}
                          data-dark-src={s.darkImage}
                          class="skill-icon-img"
                        />
                      ) : (
                        <div class="skill-fallback-icon">
                          <span class="skill-fallback-text">{s.name.slice(0, 2)}</span>
                        </div>
                      )}
                    </div>
                    <div class="skill-body">
                      <h4 class="skill-name">{s.name}</h4>
                      <span class="skill-level level-badge">{ja?.level ?? s.level}</span>
                    </div>
                  </button>
                </li>
              );
            })}
          </ul>
        </div>
      ))}

      <dialog id="skill-modal" class="modal-card" aria-modal="true" aria-labelledby="skill-modal-title">
        <div class="modal-content">
          <button id="skill-modal-close-btn" class="close-btn" aria-label="閉じる" data-i18n-aria="skills.modal.close">×</button>

          <div class="modal-image" id="skill-modal-image"></div>

          <header class="modal-header">
            <h3 id="skill-modal-title">スキル名</h3>
            <span id="skill-modal-level" class="level-badge">レベル</span>
          </header>

          <div class="modal-section">
            <h4 class="modal-subheading" data-i18n="skills.modal.what">できること</h4>
            <p id="skill-modal-skill" class="modal-detail"></p>
          </div>

          <div class="modal-section">
            <h4 class="modal-subheading" data-i18n="skills.modal.desc">説明</h4>
            <p id="skill-modal-desc" class="modal-text"></p>
          </div>
        </div>
      </dialog>
    </section>
  </main>

  <Footer />
  <BackToTop />
</BaseLayout>

<script>
  import { getSavedLocale, applyTranslations, initLocale } from '../i18n/lang-switcher';
  import { translations } from '../i18n/translations';
  import type { Locale } from '../i18n/translations';

  const root     = document.getElementById('skills');
  const modal    = document.getElementById('skill-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('skill-modal-close-btn');
  const openBtns = root ? root.querySelectorAll<HTMLButtonElement>('.open-modal-btn') : [];
  const imageWrap  = document.getElementById('skill-modal-image');
  const modalTitle = document.getElementById('skill-modal-title');
  const modalLevel = document.getElementById('skill-modal-level');
  const modalSkill = document.getElementById('skill-modal-skill');
  const modalDesc  = document.getElementById('skill-modal-desc');

  let lastCard: HTMLElement | null = null;

  function renderImage(src: string): void {
    if (!imageWrap) return;
    if (!src) { imageWrap.innerHTML = ''; imageWrap.style.display = 'none'; return; }
    imageWrap.style.display = 'block';
    imageWrap.innerHTML = `<img src="${src}" alt="" loading="lazy" />`;
  }

  function populateModal(card: HTMLElement): void {
    const locale = getSavedLocale();
    let locales: Record<string, { level: string; genre: string; skill: string; description: string }> | null = null;
    try { locales = card.dataset.locales ? JSON.parse(card.dataset.locales) : null; } catch {}
    const loc = locales?.[locale] ?? locales?.['ja'] ?? null;

    if (modalTitle) modalTitle.textContent = card.dataset.name ?? '';
    if (modalLevel) modalLevel.textContent = loc?.level ?? '';
    if (modalSkill) modalSkill.textContent = loc?.skill ?? '';
    if (modalDesc)  modalDesc.textContent  = loc?.description ?? '';
    renderImage(card.dataset.image ?? '');
  }

  openBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      lastCard = btn;
      populateModal(btn);
      modal?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal?.open) modal.close(); });

  function updateSkillCards() {
    const locale = getSavedLocale();
    openBtns.forEach((btn) => {
      let locales: Record<string, { level: string; genre: string; skill: string; description: string }> | null = null;
      try { locales = btn.dataset.locales ? JSON.parse(btn.dataset.locales) : null; } catch {}
      const loc = locales?.[locale] ?? locales?.['ja'] ?? null;
      const levelEl = btn.querySelector<HTMLElement>('.skill-level');
      if (levelEl && loc) {
        levelEl.textContent = loc.level;
      }
      btn.setAttribute('aria-label', `${btn.dataset.name ?? ''} (${loc?.level ?? ''}) の詳細を見る`);
    });

    if (modal?.open && lastCard) populateModal(lastCard);

    const dict = translations[locale];
    document.querySelectorAll<HTMLElement>('[data-i18n="skills.modal.what"]').forEach((el) => { el.textContent = dict['skills.modal.what']; });
    document.querySelectorAll<HTMLElement>('[data-i18n="skills.modal.desc"]').forEach((el) => { el.textContent = dict['skills.modal.desc']; });
  }

  document.addEventListener('i18n:update', () => {
    updateSkillCards();
  });

  // Theme-aware images
  function applyThemeImages() {
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    document.querySelectorAll<HTMLImageElement>('img[data-light-src][data-dark-src]').forEach((img) => {
      const src = isDark ? img.dataset.darkSrc : img.dataset.lightSrc;
      if (src && src !== img.src) img.src = src;
    });
  }
  applyThemeImages();
  new MutationObserver(applyThemeImages).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme'],
  });

  // Init
  const locale = initLocale();
  applyTranslations(locale);
  updateSkillCards();
</script>

<style>
  #skills { margin-block: 2rem; }

  .genre-section { margin-bottom: 2.25rem; }

  .genre-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 1rem;
    padding-bottom: 0.375rem;
    border-bottom: 2px solid var(--accent);
    overflow-wrap: break-word;
  }

  #skills h2 {
    margin: 0 0 1.25rem;
    color: var(--color-primary);
  }

  /* スキルグリッド */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.85rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill-item {
    display: flex;
  }

  /* スキルカード（インタラクティブなボタン） */
  .skill-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    padding: 1rem 0.75rem;
    cursor: pointer;
    text-align: center;
    color: var(--color-text);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    user-select: none;
    position: relative;
    font-family: inherit;
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    border-color: var(--accent);
  }

  .skill-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }

  /* アイコンエリア */
  .skill-thumb {
    width: 64px;
    height: 64px;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.65rem;
    padding: 0.5rem;
    transition: transform 0.2s ease;
  }

  .skill-card:hover .skill-thumb {
    transform: scale(1.08);
  }

  .skill-icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .skill-fallback-icon {
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
    background: var(--btn-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .skill-fallback-text {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-white);
  }

  /* スキル名とレベル */
  .skill-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
  }

  .skill-name {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--card-title);
    line-height: 1.3;
    overflow-wrap: break-word;
    word-break: break-word;
    max-width: 100%;
  }

  .skill-level.level-badge {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* ===== Modal ===== */
  .modal-card {
    border: none;
    border-radius: 1rem;
    background: var(--modal-bg);
    color: var(--modal-text);
    max-width: 48rem;
    width: calc(100% - 2rem);
    max-height: 90vh;
    overflow: hidden;
    padding: 0;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .modal-card::backdrop { background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(4px); }

  .modal-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    max-height: 90vh;
    overflow-y: auto;
  }

  .close-btn {
    align-self: flex-end;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--modal-heading);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }

  .close-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .close-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .modal-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--modal-bg);
    border-radius: 0.75rem;
    margin-bottom: 0.5rem;
    display: none;
  }

  .modal-image img { width: 100%; height: 100%; object-fit: cover; }

  .modal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--modal-heading);
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .modal-detail {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
    font-style: italic;
    overflow-wrap: break-word;
  }

  .modal-text {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--card-text);
    overflow-wrap: break-word;
  }

  .modal-section { display: flex; flex-direction: column; }

  .modal-subheading {
    margin: 0.5rem 0 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card, .skill-thumb, .skill-icon-img, .close-btn { transition: none; }
    .skill-card:hover { transform: none; }
    .skill-card:hover .skill-thumb { transform: none; }
  }

  /* Dark / Light モード対応 */
  [data-theme="light"] .skill-thumb {
    background: rgba(0, 0, 0, 0.04);
  }

  [data-theme="dark"] .skill-thumb {
    background: #ffffff;
  }
  [data-theme="dark"] .skill-icon-img {
    filter: none;
  }
</style>
